<% content_for :title, t(".title") %>

<div class="mx-auto w-full max-w-sm">
  <%= link_to pays_path(month: @pay.paid_at_in_database.strftime("%Y-%m")),
        class: "mb-2 inline-flex items-center gap-1 text-[11px] font-medium underline" do %>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
         stroke="currentColor" class="size-3" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
    </svg>
    <%= t(".back") %>
  <% end %>
</div>

<h1 class="mb-6 text-center text-[32px] leading-10"><%= t(".heading") %></h1>

<%= render "form", pay: @pay, submit_label: t(".submit"),
      back_path: pays_path(month: @pay.paid_at_in_database.strftime("%Y-%m")) %>