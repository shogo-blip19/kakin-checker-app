<% content_for :title, t(".title") %>

<% if @over_budget %>
  <div role="status" class="mx-auto mb-6 w-full max-w-sm rounded-lg bg-amber-400 px-4 py-2 text-center text-xs font-medium text-black">
    <%= t(".over_budget_notice") %>
  </div>
<% end %>

<h1 class="mb-6 text-center text-[32px] leading-10"><%= t(".heading") %></h1>

<%= render "form", pay: @pay, submit_label: t(".submit"), back_path: home_path %>