<% content_for :title, t(".title") %>

<div class="mx-auto w-full max-w-sm">
 <%= link_to archives_path(year: @month.year), class: "mb-2 inline-flex items-center gap-1 text-[11px] font-medium underline" do %>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
         stroke="currentColor" class="size-3" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
    </svg>
    <%= t(".back") %>
  <% end %>

  <h1 class="mb-8 text-center text-[32px] leading-10">
    <%= t(".heading", year: @month.year, month: @month.month) %>
  </h1>

  <h2 class="mb-3 text-base font-medium">💪 <%= t(".total_title") %></h2>
  <p class="mb-8 rounded-lg bg-card px-4 py-6 text-center text-2xl"><%= kakin_power(@total) %></p>

  <h2 class="mb-3 text-base font-medium">
    📝 <%= t(".list_title") %> <%= t(".count", count: @pays.size) %>
    
  </h2>

  <h2 class="mb-3 text-base font-medium">🎯 <%= t(".budget_title") %></h2>
  <div class="mb-8 rounded-lg bg-card px-4 py-4 text-sm">
    <% if @budget %>
      <p class="mb-2 text-base"><%= kakin_power(@budget.amount) %></p>
      <%= link_to t(".budget_edit"), edit_budget_path,
            class: "text-[11px] font-medium underline transition-colors hover:text-primary/80" %>
    <% else %>
      <p class="mb-2"><%= t(".budget_unset") %></p>
      <%= link_to t(".budget_new"), new_budget_path,
            class: "text-[11px] font-medium underline transition-colors hover:text-primary/80" %>
    <% end %>
  </div>

  <% if @pays.empty? %>
    <p class="rounded-lg bg-card px-4 py-6 text-center text-sm"><%= t(".empty") %></p>
  <% else %>
    <ul class="space-y-3">
      <% @pays.each do |pay| %>
               <li class="flex items-end justify-between gap-3 rounded-lg bg-card px-4 py-3 text-sm leading-6">
          <div>
            <p>📆 <%= l(pay.paid_at, format: :history) %></p>
            <p>🎮 <%= pay.preset_title.game_title %></p>
            <p>💪 <%= kakin_power(pay.amount) %></p>
          </div>
          <div class="flex items-center gap-4 text-[11px] font-medium">
            <%= link_to edit_pay_path(pay), class: "underline transition-colors hover:text-primary/80" do %>
              ✏️ <%= t(".edit") %>
            <% end %>
            <%= button_to pay_path(pay), method: :delete,
                  form: { data: { turbo_confirm: t(".confirm_delete") } },
                  class: "cursor-pointer underline transition-colors hover:text-primary/80" do %>
              🗑️ <%= t(".delete") %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>