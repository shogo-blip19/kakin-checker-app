<% content_for :title, t(".title") %>

<div class="mx-auto w-full max-w-sm">
  <h1 class="mb-6 text-center text-[32px] leading-10"><%= t(".heading") %></h1>

  <div class="mb-8 flex items-center justify-center gap-6">
    <% if @previous_year %>
      <%= link_to archives_path(year: @previous_year), aria: { label: t(".previous_year") },
            class: "transition-colors hover:text-primary/80" do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"
             class="size-6 rotate-180" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
      <% end %>
    <% else %>
      <span class="opacity-30" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"
             class="size-6 rotate-180"><path d="M8 5v14l11-7z" /></svg>
      </span>
    <% end %>

    <p class="text-base font-medium"><%= t(".year", year: @year) %></p>

    <% if @next_year %>
      <%= link_to archives_path(year: @next_year), aria: { label: t(".next_year") },
            class: "transition-colors hover:text-primary/80" do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"
             class="size-6" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
      <% end %>
    <% else %>
      <span class="opacity-30" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"
             class="size-6"><path d="M8 5v14l11-7z" /></svg>
      </span>
    <% end %>
  </div>

  <h2 class="mb-3 text-center text-base font-medium">📝 <%= t(".list_title") %></h2>

  <% if @months.empty? %>
    <p class="rounded-lg bg-card px-4 py-6 text-center text-sm"><%= t(".empty") %></p>
  <% else %>
    <ul class="space-y-3">
      <% @months.each do |month| %>
        <li>
          <%= link_to pays_path(month: month.strftime("%Y-%m")),
                class: "flex items-center gap-3 rounded-lg bg-card px-4 py-3 text-base font-medium transition-colors hover:bg-gray-500" do %>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                 stroke="currentColor" class="size-6" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round"
                    d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
            <span class="flex-1"><%= t(".month", year: month.year, month: month.month) %></span>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                 stroke="currentColor" class="size-4" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
            </svg>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>