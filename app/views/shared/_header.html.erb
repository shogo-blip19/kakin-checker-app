<header class="bg-bar">
  <div class="mx-auto flex h-14 max-w-md items-center justify-between px-4">
    <%= link_to t(".logo"), (logged_in? ? home_path : root_path), class: "text-base" %>
    <nav class="flex items-center gap-2 text-[11px] font-medium">
      <% if logged_in? %>
        <%= button_to t(".logout"), logout_path, method: :delete, class: "cursor-pointer underline" %>
      <% else %>
        <%= link_to "👤 #{t('.sign_up')}", new_user_path, class: "underline" %>
        <span>|</span>
        <%= link_to "🚪 #{t('.login')}", login_path, class: "underline" %>
      <% end %>
    </nav>
  </div>
</header>